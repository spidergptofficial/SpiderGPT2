# Copy of root .env.example for backend directory
# Refer to root .env.example for full documentation
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
APPLICATION_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

JWT_SECRET_KEY=spidergpt-dev-secret-key-32-characters-minimum-for-testing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=sqlite+aiosqlite:///./spidergpt.db
DATABASE_ECHO=false

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
DEEPSEEK_MODEL=deepseek-chat

WEB_SEARCH_PROVIDER=duckduckgo

DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata
