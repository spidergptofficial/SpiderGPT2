# SpiderGPT backend environment template.
# Never commit real secrets. Production must use PostgreSQL, Redis, Supabase Auth,
# explicit CORS origins, non-local storage, and real AI credentials.

ENVIRONMENT=development
DEBUG=false
PORT=8000
HOST=0.0.0.0

APPLICATION_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Internal session signing key (production: random >=32 chars)
JWT_SECRET_KEY=replace-with-a-random-production-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Development may use SQLite. Production requires PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./spidergpt.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Supabase Auth (production required)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=spidergpt-assets
STORAGE_LOCAL_DIR=./uploads

AI_PROVIDER=gemini
FALLBACK_AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

IMAGE_PROVIDER=openai
IMAGE_MODEL=dall-e-3

WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=

REDIS_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Recurring Razorpay plan IDs (create these in Razorpay Dashboard; never use order IDs here)
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_PLUS_MONTHLY=
RAZORPAY_PLAN_PLUS_YEARLY=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata
ADMIN_EMAILS=
RATE_LIMIT_PER_MINUTE=120
