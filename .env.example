# ==============================================================================
# SPIDERGPT ENVIRONMENT CONFIGURATION
# “Your AI Sidekick” - Production Backend Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
APPLICATION_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & JWT Secrets
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-super-secret-hex-token-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL / Supabase Postgres / SQLite for tests)
# For Supabase PostgreSQL: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
# For local SQLite: sqlite+aiosqlite:///./spidergpt.db
DATABASE_URL=sqlite+aiosqlite:///./spidergpt.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Supabase Integration (Optional if using direct PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis Configuration (Optional - in-memory fallback enabled if absent)
REDIS_URL=redis://localhost:6379/0

# Storage Provider (options: local, supabase, s3)
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=spidergpt-assets
STORAGE_LOCAL_DIR=./uploads

# AI Providers Configuration
# Primary AI Provider (options: gemini, openai, openrouter, deepseek)
AI_PROVIDER=gemini
# Optional Fallback Provider if primary encounters temporary errors/rate limits
FALLBACK_AI_PROVIDER=openai

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Image Generation Provider (options: openai, gemini, mock)
IMAGE_PROVIDER=openai
IMAGE_MODEL=dall-e-3

# Web Search Provider (options: tavily, serper, duckduckgo)
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=

# Payments: Razorpay (Preferred for India / INR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Recurring Razorpay plan IDs (create these in Razorpay Dashboard; never use order IDs here)
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_PLUS_MONTHLY=
RAZORPAY_PLAN_PLUS_YEARLY=

# Payments: Stripe (Preferred for Global / USD / EUR)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Regional Currency & Pricing Defaults
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata
